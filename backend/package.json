{
  "name": "phone-shop-backend",
  "version": "1.0.0",
  "description": "Backend API for Phone & Accessories Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "backup": "node src/scripts/backup-now.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
