# Shop database. This is a SQLite file on the shop computer. Do not point this at PostgreSQL.
DATABASE_URL="file:./dev.db"
PORT=5000
JWT_SECRET="replace-with-a-long-random-string"

# Optional. Leave open for the shop LAN and the Android till. Set a list when you host publicly.
# CORS_ORIGIN="http://localhost:3000"

# Daily SQLite backup on this server. Time is Africa/Dar_es_Salaam.
BACKUP_DIR="backups"
BACKUP_CRON="15 2 * * *"
BACKUP_RETENTION_DAYS=30

# 32-byte hex key. If empty, the server creates backend/data/backup.key and keeps it on this machine.
# BACKUP_ENCRYPTION_KEY=

# Second copy, outside this server. Amazon S3 or Backblaze B2.
# B2 example endpoint: https://s3.us-west-004.backblazeb2.com  region: us-west-004
# OFFSITE_S3_ENDPOINT=
# OFFSITE_S3_REGION=
# OFFSITE_S3_BUCKET=
# OFFSITE_S3_ACCESS_KEY=
# OFFSITE_S3_SECRET_KEY=
# OFFSITE_S3_PREFIX=phonevault

# Tanzania SMS for the receipt and warranty text. Leave empty until the real gateway account exists.
# SMS_PROVIDER="beem"
# SMS_API_KEY=
# SMS_API_SECRET=
# SMS_SENDER_ID=
# NextSMS uses the same four values with SMS_PROVIDER="nextsms"

# Where this shop pushes sales after the internet returns. Leave empty until the real host exists.
# CLOUD_API_URL="https://your-host.example.com"
# SYNC_TOKEN="same-secret-on-shop-and-cloud"
# IS_CLOUD="true"
